<resources>
 <style name="MyTasks.Light" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">@font/inter_variable</item>
  <item name="android:colorAccent">#245CC6</item>
  <item name="android:colorControlActivated">#245CC6</item>
  <item name="android:colorControlNormal">#536176</item>
  <item name="android:colorButtonNormal">#FFFFFF</item>
  <item name="android:colorBackground">#F4F6FA</item>
  <item name="android:windowBackground">#F4F6FA</item>
  <item name="android:textColorPrimary">#17243B</item>
  <item name="android:textColorSecondary">#536176</item>
  <item name="android:textColorHint">#536176</item>
  <item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="MyTasks.Dark" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">@font/inter_variable</item>
  <item name="android:colorAccent">#A9C7FF</item>
  <item name="android:colorControlActivated">#A9C7FF</item>
  <item name="android:colorControlNormal">#ADBCD0</item>
  <item name="android:colorButtonNormal">#1A2432</item>
  <item name="android:colorBackground">#111820</item>
  <item name="android:windowBackground">#111820</item>
  <item name="android:textColorPrimary">#EDF2F9</item>
  <item name="android:textColorSecondary">#ADBCD0</item>
  <item name="android:textColorHint">#ADBCD0</item>
  <item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="SheetWindowMotion">
  <item name="android:windowEnterAnimation">@null</item>
  <item name="android:windowExitAnimation">@anim/sheet_exit</item>
 </style>
</resources>
