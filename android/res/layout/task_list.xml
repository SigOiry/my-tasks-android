<?xml version="1.0" encoding="utf-8"?>
<!-- Compact: all list chrome, search and rows share one vertical viewport. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list_scroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:id="@+id/list_header"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <LinearLayout android:id="@+id/list_controls"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <LinearLayout android:id="@+id/list_rows"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
